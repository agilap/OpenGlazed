# ── Database (local Postgres + pgvector, see docker-compose.yml) ──
# With `docker compose up -d`, use this exact URL:
DATABASE_URL=postgresql://glazed:glazed@localhost:5432/glazed

# ── LLM keys (generation + summarization) ──
# The backend uses OpenAI-compatible chat for summaries/answers.
OPENAI_API_KEY=your-openai-api-key

# ── Model server (optional) ──
# Without it, the backend answers from retrieval only (no grounded generation).
MODEL_API_URL=http://localhost:8000
ROBERTA_MODEL_PATH=
ADAPTER_PATH=

# ── App ──
CONFIDENCE_THRESHOLD=0.35
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_EMBED_ORIGIN=http://localhost:5173
