# Database (docker compose up -d)
DATABASE_URL=postgresql://glazed:glazed@localhost:55434/glazed

# Models: any OpenAI-compatible /v1 endpoint
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small
# EMBED_BASE_URL=            # if the chat provider has no embeddings
# EMBED_API_KEY=
# EMBED_DIM=1536             # auto-detected

# Agent
# AGENT_MAX_STEPS=4
# RAG_QUERY_REWRITE=false
# RAG_COSINE_RERANK=false
# LLM_STREAM_USAGE=false
# TRACE_RETENTION_DAYS=7
# TRACE_MAX_PER_BUSINESS=1000
# EVAL_SAMPLE_RATE=0.1       # 0 = off
# CHAT_RATE_PER_MINUTE=20    # per visitor IP per workspace
# CHAT_DAILY_LIMIT=2000      # per workspace
# PARSE_TIMEOUT_MS=60000

# App
CONFIDENCE_THRESHOLD=0.35
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_EMBED_ORIGIN=http://localhost:5173
# COOKIE_SECURE=             # default: true when NODE_ENV=production
# TRUST_PROXY=1              # behind a reverse proxy
# ADMIN_TOKEN=               # optional superuser token; unset = disabled

# Email (alerts, confirmation, password reset)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=assistant@example.com
# SMTP_SECURE=false
# APP_URL=http://localhost:5173
