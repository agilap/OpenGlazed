# ── Database (local Postgres + pgvector, see docker-compose.yml) ──
# With `docker compose up -d`, use this exact URL:
DATABASE_URL=postgresql://glazed:***@localhost:5432/glazed

# ── Models (local-first by default) ────────────────────────────────
# OpenGlazed is provider-agnostic. It talks the OpenAI-compatible /v1 API,
# so Ollama / LocalAI / LM Studio / vLLM all work locally with NO API key.
#
# Default: both chat + embeddings run on Ollama (boot it via `docker compose up`).
#   pull models once:  docker exec -it glazed-ollama ollama pull llama3.1
#                       docker exec -it glazed-ollama ollama pull nomic-embed-text
#
# To use OpenAI instead, set:
#   LLM_PROVIDER=openai
#   EMBED_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#   (optional) OPENAI_BASE_URL=https://api.openai.com/v1

LLM_PROVIDER=ollama            # ollama | openai
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
# EMBED_DIM=768             # set if your embed model differs from the table

EMBED_PROVIDER=ollama         # ollama | openai
# EMBED_MODEL=text-embedding-3-small   # used when EMBED_PROVIDER=openai
# CHAT_MODEL=gpt-4o-mini              # used when LLM_PROVIDER=openai

# ── Model server (optional, legacy rerank/cluster override) ──
# Without it, RAPTOR clustering + rerank fall back to built-in behaviour.
MODEL_API_URL=http://localhost:8000
ROBERTA_MODEL_PATH=
ADAPTER_PATH=

# ── App ──
CONFIDENCE_THRESHOLD=0.35
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_EMBED_ORIGIN=http://localhost:5173

# ── Admin auth ──
# Dashboard data, ingest, source ingestion, and business creation are protected by
# a Bearer token. Set a strong value here for production. If unset, the server
# generates an ephemeral token at boot and prints it to the console (dev only —
# it changes every restart).
# ADMIN_TOKEN=your-strong-secret
