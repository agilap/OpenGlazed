# ── Database (local Postgres + pgvector, see docker-compose.yml) ──
# With `docker compose up -d`, use this exact URL:
DATABASE_URL=postgresql://glazed:glazed@localhost:55434/glazed

# ── Models (bring your own API) ─────────────────────────────────
# Model-agnostic: any OpenAI-compatible /v1 endpoint works — OpenAI, OpenRouter,
# Groq, Together, Mistral, Gemini (OpenAI-compat endpoint), Anthropic
# (OpenAI-compat endpoint), or a self-hosted vLLM / LM Studio / Ollama server.
# The agent uses tool calling; providers without it fall back to plain RAG.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Embeddings default to the chat provider above. Set these when your chat
# provider has no embeddings endpoint (e.g. Anthropic, Groq).
# Changing the embedding model is safe: stored content is re-embedded on restart.
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=1536             # optional: detected from the embedding model at startup

# ── Agent ──
# AGENT_MAX_STEPS=4          # max tool-calling rounds per message
# RAG_QUERY_REWRITE=false   # optional lexical expansion in plain-RAG fallback
# RAG_COSINE_RERANK=false   # legacy dense-only rerank; may reduce lexical relevance
# LLM_STREAM_USAGE=false   # only enable if provider accepts stream_options.include_usage
# TRACE_RETENTION_DAYS=7
# TRACE_MAX_PER_BUSINESS=1000
# EVAL_SAMPLE_RATE=0.1       # share of widget answers scored by the LLM judge (0 = off)

# ── App ──
CONFIDENCE_THRESHOLD=0.35
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_EMBED_ORIGIN=http://localhost:5173

# Set to true when serving the frontend over HTTPS in production.
# COOKIE_SECURE=true

# ── Admin auth ──
# Dashboard data, ingest, source ingestion, and business creation are protected by
# a Bearer token. Set a strong value here for production. If unset, the server
# generates an ephemeral token at boot and prints it to the console (dev only —
# it changes every restart).
# ADMIN_TOKEN=your-strong-secret

# ── Unanswered question notifications ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=assistant@example.com
# SMTP_SECURE=false
# APP_URL=http://localhost:5173
